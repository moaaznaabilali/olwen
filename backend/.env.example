# Olwen backend configuration
APP_NAME=Olwen
ENTITY_NAME=Olwen
ENVIRONMENT=development

# PostgreSQL (async driver). Default matches a local Postgres.app install.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/olwen

# Auth — CHANGE JWT_SECRET in production to a long random string.
JWT_SECRET=dev-secret-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend origins allowed to call this API (JSON array).
CORS_ORIGINS=["http://localhost:3000","http://localhost:3100"]

# LLM — users connect their OWN Claude or Gemini key in Settings. These env
# keys are optional fallbacks/defaults only.
LLM_PROVIDER=gemini
# Claude (paid API) — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email OTP (signup verification).
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
# "console" logs the code (dev, no key needed). Switch to "resend" for real email.
EMAIL_PROVIDER=console
# Get a key at https://resend.com (free tier). Then set EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# onboarding@resend.dev works for testing (delivers only to your Resend email).
# For real users, verify your domain in Resend and use e.g. "Olwen <hi@yourdomain>".
EMAIL_FROM=Olwen <onboarding@resend.dev>
